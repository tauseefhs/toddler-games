// Cloudflare settings: publish the site folder as my private games site.
{
  "name": "toddler-games",
  "compatibility_date": "2026-11-12",
  // Only serve on games.tauseefhussain.com (behind Cloudflare Access), never on workers.dev
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "games.tauseefhussain.com", "custom_domain": true }
  ],
  "assets": { "directory": "./site" }
}
